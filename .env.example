# =============================================================================
# CreatorOS — Environment Variables Template
# =============================================================================
# This file IS committed to git. It documents every env var the project needs.
# ✅  Copy this file to .env and fill in your real values:
#     cp .env.example .env
# ⚠️  Never put real secrets in this file.
# =============================================================================


# -----------------------------------------------------------------------------
# SUPABASE
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql://postgres:[password]@db.your-project-ref.supabase.co:5432/postgres


# -----------------------------------------------------------------------------
# OPENAI
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_WHISPER_MODEL=whisper-1


# -----------------------------------------------------------------------------
# STRIPE
# -----------------------------------------------------------------------------
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret
STRIPE_PRICE_PRO_MONTHLY=price_your-pro-monthly-price-id
STRIPE_PRICE_AGENCY_MONTHLY=price_your-agency-monthly-price-id


# -----------------------------------------------------------------------------
# AWS S3
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=creatoros-raw-media


# -----------------------------------------------------------------------------
# CLOUDFLARE R2
# -----------------------------------------------------------------------------
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=creatoros-clips
R2_PUBLIC_URL=https://clips.your-domain.com


# -----------------------------------------------------------------------------
# INNGEST
# -----------------------------------------------------------------------------
INNGEST_EVENT_KEY=your-inngest-event-key
INNGEST_SIGNING_KEY=your-inngest-signing-key


# -----------------------------------------------------------------------------
# RUNPOD
# -----------------------------------------------------------------------------
RUNPOD_API_KEY=your-runpod-api-key
RUNPOD_WHISPER_ENDPOINT_ID=your-runpod-endpoint-id


# -----------------------------------------------------------------------------
# UIPATH
# -----------------------------------------------------------------------------
UIPATH_CLIENT_ID=your-uipath-client-id
UIPATH_CLIENT_SECRET=your-uipath-client-secret
UIPATH_TENANT_NAME=your-uipath-tenant-name
UIPATH_ORGANIZATION_ID=your-uipath-organization-id
UIPATH_FOLDER_ID=your-uipath-folder-id
UIPATH_WEBHOOK_SECRET=your-uipath-webhook-secret


# -----------------------------------------------------------------------------
# SENDGRID
# -----------------------------------------------------------------------------
SENDGRID_API_KEY=SG.your-sendgrid-api-key
SENDGRID_FROM_EMAIL=hello@your-domain.com
SENDGRID_FROM_NAME=CreatorOS


# -----------------------------------------------------------------------------
# SENTRY
# -----------------------------------------------------------------------------
VITE_SENTRY_DSN=https://your-public-key@sentry.io/your-project-id
SENTRY_DSN=https://your-public-key@sentry.io/your-backend-project-id
SENTRY_ENVIRONMENT=development


# -----------------------------------------------------------------------------
# POSTHOG
# -----------------------------------------------------------------------------
VITE_POSTHOG_KEY=phc_your-posthog-project-api-key
VITE_POSTHOG_HOST=https://app.posthog.com


# -----------------------------------------------------------------------------
# LANGFUSE
# -----------------------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=pk-lf-your-langfuse-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-langfuse-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com


# -----------------------------------------------------------------------------
# PYTHON MICROSERVICES
# -----------------------------------------------------------------------------
EMBEDDER_SERVICE_URL=https://embedder.your-domain.com
EMBEDDER_SERVICE_SECRET=your-shared-secret-for-embedder


# -----------------------------------------------------------------------------
# APP / GENERAL
# -----------------------------------------------------------------------------
VITE_APP_URL=http://localhost:5173
VITE_API_URL=http://localhost:3001
API_INTERNAL_URL=http://localhost:3001
API_INTERNAL_SECRET=your-strong-random-internal-secret
NODE_ENV=development
